# ═══════════════════════════════════════════════════════════════
#  FightFlex Client — Environment Variables EXAMPLE
#  Copy this file to .env and fill in your actual values.
#  ⚠️  NEVER put real secrets in this file — it IS committed to git
# ═══════════════════════════════════════════════════════════════

# ── API Base URL ─────────────────────────────────────────────
# LOCAL DEV  → http://localhost:5000
# PRODUCTION → https://your-server.vercel.app
VITE_API_URL=http://localhost:5000

# ── Google OAuth (optional) ──────────────────────────────────
# Get from: https://console.cloud.google.com → Credentials → OAuth 2.0 Client ID
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
